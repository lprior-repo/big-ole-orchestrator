      \"THE SYSTEM SHALL define Dag::connect<T>(from: &NodeHandle<_, T>, to: &NodeHandle<T, _>) that statically enforces Output(from) == Input(to).\",
      \"THE SYSTEM SHALL define Dag::build() -> Result<WorkflowDefinition, DagBuildError> that runs cycle detection (Kahns algorithm) and returns the serializable WorkflowDefinition.\",
      \"THE SYSTEM SHALL define DagBuildError::CycleDetected { nodes: Vec<String> } for detected cycles.\"
    ]
    event_driven: [
      {trigger: \"WHEN Dag::connect is called with mismatched types\", shall: \"THE SYSTEM SHALL produce a compile-time type error — no runtime check needed.\"},
      {trigger: \"WHEN Dag::build() is called\", shall: \"THE SYSTEM SHALL run Kahns cycle detection algorithm and return Err(CycleDetected) for cyclic graphs.\"}
    ]
    unwanted: [
      {condition: \"IF type mismatch is detected at runtime instead of compile time\", shall_not: \"THE SYSTEM SHALL NOT use runtime type checks for edge connections\", because: \"compile-time enforcement is the entire value of NodeHandle<I,O>.\"},
      {condition: \"IF cycle detection runs only in the engine and not in the SDK\", shall_not: \"THE SYSTEM SHALL NOT omit SDK-side cycle detection\", because: \"ADR-022 requires the binary itself to fail --graph with a cycle error before the engine can reject it.\"}
    ]
  }

